<div class="form-container">
  <h1>ノートを編集</h1>

  <div class="form-card">
    <% if @note.errors.any? %>
      <div class="error-messages">
        <% @note.errors.full_messages.each do |msg| %>
          <p class="error"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with(model: [@word, @note]) do |f| %>
      <div class="form-group">
        <%= f.label :body, "内容" %>
        <%= f.text_area :body, class: "note-textarea", placeholder: "この言葉に助けられたエピソードや、得られた気づき、感想などを自由に残してください。" %>
      </div>

      <div class="form-actions">
        <%= f.submit "更新する", class: "link-action", style: "background: none; border: none; padding: 0; cursor: pointer;" %>
        <%= link_to "戻る", word_path(@word), class: "link-action" %>
      </div>
    <% end %>
  </div>
</div>