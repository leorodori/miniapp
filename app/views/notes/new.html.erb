<h2>新しいメモを追加</h2>

<% if @note.errors.any? %>
  <div class="error-messages">
    <% @note.errors.full_messages.each do |msg| %>
      <p class="error"><%= msg %></p>
    <% end %>
  </div>
<% end %>

<%= form_with(model: [@word, @note]) do |f| %>
  <div class="new-note-container">
    <%= f.label :body, "内容" %><br>
    <%= f.text_area :body, class: "word-textarea" %>

    <div style="margin-top: 12px; display: flex; gap: 12px;">
      <%= link_to "保存する",
            word_notes_path(@word),
            data: { turbo_method: :post },
            class: "link-action" %>

      <%= link_to "戻る", word_path(@word), class: "link-action" %>
    </div>
  </div>
<% end %>