<div class="form-container">
  <h1>フォルダ名の編集</h1>

  <div class="form-card">
    <% if @folder.errors.any? %>
      <div class="error-messages">
        <% @folder.errors.full_messages.each do |msg| %>
          <p class="error"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @folder, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name, "フォルダ名" %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <div class="form-actions">
        <%= f.submit "更新する", class: "link-action" %>
        <%= link_to "キャンセル", folders_path, class: "link-action" %>
      </div>
    <% end %>
  </div>
</div>