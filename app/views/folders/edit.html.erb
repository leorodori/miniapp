<h1>フォルダ名の編集</h1>

<div style="border: 1px solid #ccc; padding: 20px; border-radius: 6px; max-width: 400px;">

  <% if @folder.errors.any? %>
    <div style="color: red; margin-bottom: 16px;">
      <ul>
        <% @folder.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @folder, local: true do |f| %>
    <div style="margin-bottom: 16px;">
      <%= f.label :name, "フォルダ名", style: "display: block; margin-bottom: 6px;" %>
      <%= f.text_field :name, style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
    </div>

    <div style="display: flex; gap: 12px;">
      <%= f.submit "更新する", class: "link-action", style: "background: none; border: none; padding: 0; cursor: pointer;" %>
      <%= link_to "キャンセル", folders_path, class: "link-action" %>
    </div>
  <% end %>

</div>