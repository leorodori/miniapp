<h1>ログイン</h1>

<%= form_with url: login_path, method: :post, local: true do |f| %>
  <div>
    <%= f.label :email, "メールアドレス" %><br>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password, "パスワード" %><br>
    <%= f.password_field :password %>
  </div>

  <%= f.submit "ログイン" %>
<% end %>

<%= link_to "新規登録はこちら", new_user_path %>
