<div class="form-container">
  <h1>ログイン</h1>

  <div class="form-card">
    <% if flash[:alert] %>
      <div class="error-messages">
        <p class="error"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= form_with url: login_path, method: :post do |f| %>
      <div class="form-group">
        <%= f.label :email, "メールアドレス" %>
        <%= f.text_field :email, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, class: "form-control" %>
      </div>

      <div class="form-actions">
        <%= f.submit "ログイン", class: "link-action" %>
      </div>
    <% end %>

    <div class="form-footer">
      <div class="forgot-password-link">
        <%= link_to "パスワードをお忘れですか？", new_password_reset_path, class: "link-action" %>
      </div>

      <div class="guest-login-section" style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #eee;">
        <%= button_to "サンプル閲覧モードで始める", guest_login_path, method: :post, class: "link-action" %>
      </div>
    </div>
  </div>
</div>