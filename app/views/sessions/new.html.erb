<h1>ログイン</h1>

<div class="login-container">
  <%= form_with url: login_path, method: :post do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.text_field :email %>
    </div>

    <div class="field">
      <%= f.label :password, "パスワード" %><br>
      <%= f.password_field :password %>
    </div>

    <div class="actions">
      <%= f.submit "ログイン" %>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <p class="login-error"><%= flash[:alert] %></p>
  <% end %>
</div>