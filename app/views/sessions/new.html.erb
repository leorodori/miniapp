<h1>ログイン</h1>

<div class="login-container">
  <%= form_with url: login_path, method: :post do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.text_field :email, class: "login-input" %>
    </div>

    <div class="field">
      <%= f.label :password, "パスワード" %><br>
      <%= f.password_field :password, class: "login-input" %>
    </div>

    <div class="actions">
      <%= f.submit "ログイン" %>
    </div>
  <% end %>

  <div class="forgot-password-link" style="margin-top: 15px;">
    <%= link_to "パスワードをお忘れですか？", new_password_reset_path %>
  </div>

  <div class="guest-login-section" style="margin-top: 20px; border-top: 1px solid #ddd; padding-top: 15px;">
    <%= button_to "サンプル閲覧モードで始める", guest_login_path, method: :post, class: "guest-login-btn" %>
  </div>

  <% if flash[:alert] %>
    <p class="login-error"><%= flash[:alert] %></p>
  <% end %>

  <% if flash[:alert] %>
    <p class="login-error"><%= flash[:alert] %></p>
  <% end %>
</div>