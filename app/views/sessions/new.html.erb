<h1>ログイン</h1>

<%= form_with url: login_path, method: :post do |f| %>
  <div>
    <%= f.label :email, "メールアドレス" %><br>
    <%= f.text_field :email %>
  </div>

  <div>
    <%= f.label :password, "パスワード" %><br>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.submit "ログイン" %>
  </div>
<% end %>

<% if flash[:alert] %>
  <p style="color: red;"><%= flash[:alert] %></p>
<% end %>