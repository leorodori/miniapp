<h1>言葉を編集</h1>

<div style="border: 1px solid #ccc; padding: 20px; border-radius: 6px; max-width: 500px;">

  <% if @word.errors.any? %>
    <div style="color: red; margin-bottom: 16px;">
      <ul>
        <% @word.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @word, local: true do |f| %>
    <div style="margin-bottom: 16px;">
      <%= f.label :folder_id, "フォルダ", style: "display: block; margin-bottom: 6px;" %>
      <%= f.collection_select :folder_id, @folders, :id, :name, { include_blank: "指定なし（未分類）" }, { style: "width: 100%; padding: 8px;" } %>
    </div>

    <div style="margin-bottom: 16px;">
      <%= f.label :name, "言葉", style: "display: block; margin-bottom: 6px;" %>
      <%= f.text_area :name, class: "word-textarea", style: "min-height: 120px;" %>
    </div>

    <div style="margin-bottom: 16px;">
      <%= f.label :description, "どういう言葉？", style: "display: block; margin-bottom: 6px;" %>
      <%= f.text_area :description, class: "word-textarea", style: "min-height: 160px;" %>
    </div>

    <div style="display: flex; gap: 12px;">

      <%= f.submit "更新する",
            class: "link-action",
            style: "background: none; border: none; padding: 0; cursor: pointer;" %>

      <%= link_to "戻る", word_path(@word), class: "link-action" %>

    </div>

  <% end %>
</div>