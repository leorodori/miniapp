<div class="form-container">
  <h1>言葉を編集</h1>

  <div class="form-card">
    <% if @word.errors.any? %>
      <div class="error-messages">
        <% @word.errors.full_messages.each do |msg| %>
          <p class="error"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @word, local: true do |f| %>

      <!-- フォルダ選択（folder_id） -->
      <div class="form-group">
        <%= f.label :folder_id, "フォルダ" %>
        <%= f.collection_select :folder_id, @folders, :id, :name, { include_blank: "指定なし（未分類）" }, { class: "form-control" } %>
      </div>

      <!-- 言葉（name） -->
      <div class="form-group">
        <%= f.label :name, "言葉" %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <!-- どういう言葉？（description） -->
      <div class="form-group">
        <%= f.label :description, "どういう言葉？" %>
        <%= f.text_area :description, class: "word-textarea", style: "height: 160px;" %>
      </div>

      <div class="form-actions">
        <%= f.submit "更新する", class: "link-action" %>
        <%= link_to "戻る", word_path(@word), class: "link-action" %>
      </div>

    <% end %>
  </div>
</div>