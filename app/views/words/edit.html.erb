<h1>言葉を編集</h1>

<div style="border: 1px solid #ccc; padding: 20px; border-radius: 6px; max-width: 500px;">

  <% if @word.errors.any? %>
    <div style="color: red; margin-bottom: 16px;">
      <ul>
        <% @word.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @word do |f| %>

    <div style="margin-bottom: 16px;">
      <%= f.label :title, "タイトル", style: "display: block; margin-bottom: 6px;" %>
      <%= f.text_field :title, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 16px;">
      <%= f.label :content, "内容", style: "display: block; margin-bottom: 6px;" %>
      <%= f.text_area :content, class: "word-textarea" %>
    </div>

    <div style="margin-bottom: 16px;">
      <%= f.label :description, "説明", style: "display: block; margin-bottom: 6px;" %>
      <%= f.text_area :description, class: "word-textarea" %>
    </div>

    <div style="display: flex; gap: 12px;">
      <%= f.submit "更新する", class: "btn", style: "padding: 8px 16px;" %>
      <%= link_to "戻る", word_path(@word), class: "link-action" %>
    </div>

  <% end %>
</div>