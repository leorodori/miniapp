<h1>新しい言葉を登録</h1>

<div style="border: 1px solid #ccc; padding: 20px; border-radius: 6px; max-width: 500px;">

  <% if @word.errors.any? %>
    <div style="color: red; margin-bottom: 16px;">
      <ul>
        <% @word.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @word do |f| %>

    <!-- 言葉（name） -->
    <div style="margin-bottom: 16px;">
      <%= f.label :name, "言葉", style: "display: block; margin-bottom: 6px;" %>
      <%= f.text_field :name, style: "width: 100%; padding: 8px;" %>
    </div>

    <!-- どんな言葉？（description） -->
    <div style="margin-bottom: 16px;">
      <%= f.label :description, "どんな言葉？", style: "display: block; margin-bottom: 6px;" %>
      <%= f.text_area :description, class: "word-textarea", style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="display: flex; gap: 12px;">
      <%= f.submit "登録する", class: "btn", style: "padding: 8px 16px;" %>
      <%= link_to "戻る", words_path, class: "link-action" %>
    </div>

  <% end %>
</div>