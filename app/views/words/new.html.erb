<div class="form-container">
  <h1>新しい言葉を登録</h1>

  <div class="form-card">
    <% if @word.errors.any? %>
      <div class="error-messages">
        <% @word.errors.full_messages.each do |msg| %>
          <p class="error"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @word, local: true do |f| %>

      <div class="form-group">
        <%= f.label :folder_id, "フォルダ" %>
        <%= f.collection_select :folder_id, @folders, :id, :name, { include_blank: "指定なし（未分類）" }, { class: "form-control" } %>
      </div>

      <div class="form-group">
        <%= f.label :name, "言葉" %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :description, "どんな言葉？" %>
        <%= f.text_area :description, class: "word-textarea", style: "height: 120px;" %>
      </div>

      <div class="form-actions">
        <%= f.submit "登録する", class: "link-action" %>
        <%= link_to "戻る", words_path, class: "link-action" %>
      </div>

    <% end %>
  </div>
</div>