<div style="
  background: #f5f5dc; /* 掲示板のベージュ */
  padding: 40px;
  min-height: 600px;
  border: 2px solid #d2b48c;
">

  <!-- Word（タイトル） -->
  <div style="
    font-size: 28px;
    font-weight: bold;
    margin-bottom: 30px;
    padding: 10px 20px;
    background: #ffffff;
    display: inline-block;
  ">
    <%= @word.name %>
  </div>

  <!-- メモ一覧（付箋を貼る領域） -->
  <div style="
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  ">
    <% @word.notes.each do |note| %>
      <div style="
        width: 200px;
        height: 200px;
        background: #fff59d;
        padding: 15px;
        position: relative;
        box-shadow: 0 4px 6px rgba(0,0,0,0.15);
      ">
        <p style="white-space: pre-wrap;"><%= note.body %></p>

        <div style="position: absolute; bottom: 10px; left: 10px;">
          <%= link_to "編集", edit_word_note_path(@word, note), class: "btn", style: "margin-right: 8px;" %>
          <%= link_to "削除", word_note_path(@word, note),
               data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
               class: "btn-danger" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- メモ追加 -->
  <div style="margin-top: 30px;">
    <%= link_to "新しいメモを追加する", new_word_note_path(@word), class: "btn" %>
  </div>

</div>