<h1>あなたの言葉一覧</h1>

<div class="board-container">

  <!-- 🔍 検索フォーム追加 -->
  <div style="margin-bottom: 20px;">
    <%= form_with url: words_path, method: :get, local: true do |f| %>
      <div style="display: flex; gap: 8px;">
        <%= f.text_field :q,
              value: params[:q],
              placeholder: "検索ワードを入力",
              class: "word-search-input",
              style: "flex: 1; padding: 6px;" %>

        <%= f.submit "検索", class: "link-action", style: "padding: 6px 12px;" %>
      </div>
    <% end %>
  </div>

  <div class="word-add">
    <%= link_to "新しい言葉を追加する", new_word_path, class: "btn" %>
  </div>

  <!-- カード一覧 -->
  <div class="word-list">
    <% @words.each do |word| %>
      <div class="word-card">

        <!-- Word の名前 -->
        <div class="word-name">
          <%= word.name %>
        </div>

        <!-- メタ情報 -->
        <p class="word-meta">作成日: <%= word.created_at.strftime("%Y-%m-%d") %></p>
        <p class="word-meta">メモ数: <%= word.notes.count %></p>

        <!-- 操作リンク（リンク風） -->
        <div class="word-actions flow" style="margin-top: 12px;">
          <%= link_to "詳細", word_path(word), class: "link-action" %>
          <%= link_to "編集", edit_word_path(word, from: :index), class: "link-action" %>
          <%= link_to "削除", word_path(word),
               data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
               class: "link-action link-action-danger" %>
        </div>

      </div>
    <% end %>
  </div>

</div>