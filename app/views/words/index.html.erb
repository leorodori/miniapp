<h1>あなたの言葉一覧</h1>

<div style="
  background: #f5f5dc; /* 掲示板の仮背景（後で画像にする） */
  padding: 40px;
  min-height: 600px;
  border: 2px solid #d2b48c;
">

  <div style="margin-bottom: 20px;">
    <%= link_to "新しい言葉を追加する", new_word_path, class: "btn" %>
  </div>

  <!-- 掲示板に貼られたカード一覧 -->
  <div style="
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  ">
    <% @words.each do |word| %>
      <div style="
        width: 220px;
        height: 160px;
        background: #ffffff;
        padding: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.15);
        position: relative;
      ">
        <div style="font-size: 18px; font-weight: bold; margin-bottom: 8px;">
          <%= word.name %>
        </div>

        <p style="font-size: 12px; color: #666;">作成日: <%= word.created_at.strftime("%Y-%m-%d") %></p>
        <p style="font-size: 12px; color: #666;">メモ数: <%= word.notes.count %></p>

        <div style="position: absolute; bottom: 10px; left: 10px;">
          <%= link_to "詳細", word_path(word), class: "btn-secondary" %>
          <%= link_to "編集", edit_word_path(word), class: "btn", style: "margin-left: 8px;" %>
          <%= link_to "削除", word_path(word),
               data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
               class: "btn-danger",
               style: "margin-left: 8px;" %>
        </div>
      </div>
    <% end %>
  </div>

</div>