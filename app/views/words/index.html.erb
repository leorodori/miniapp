<h1>あなたの言葉一覧</h1>

<div class="board-container">

  <div class="word-add">
    <%= link_to "新しい言葉を追加する", new_word_path, class: "btn" %>
  </div>

  <!-- カード一覧 -->
  <div class="word-list">
    <% @words.each do |word| %>
      <div class="word-card">

        <div class="word-name">
          <%= word.name %>
        </div>

        <p class="word-meta">作成日: <%= word.created_at.strftime("%Y-%m-%d") %></p>
        <p class="word-meta">メモ数: <%= word.notes.count %></p>

        <div class="word-actions flow">
          <%= link_to "メモを見る", word_path(word), class: "btn-secondary" %>
          <%= link_to "言葉を編集", edit_word_path(word), class: "btn", style: "margin-left: 8px;" %>
          <%= link_to "言葉を削除", word_path(word),
               data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
               class: "btn-danger",
               style: "margin-left: 8px;" %>
        </div>

      </div>
    <% end %>
  </div>

</div>