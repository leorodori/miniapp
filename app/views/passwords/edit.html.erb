<div class="form-container">
  <h1>パスワードの変更</h1>

  <div class="form-card">
    <% if @user.errors.any? %>
      <div class="error-messages">
        <% @user.errors.full_messages.each do |message| %>
          <p class="error"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with(model: @user, url: password_path, method: :patch, local: true) do |f| %>
      <div class="form-group">
        <%= f.label :current_password, "現在のパスワード" %>
        <%= f.password_field :current_password, required: true, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "新しいパスワード" %>
        <%= f.password_field :password, required: true, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "新しいパスワード（確認用）" %>
        <%= f.password_field :password_confirmation, required: true, class: "form-control" %>
      </div>

      <div class="form-actions">
        <%= f.submit "パスワードを変更する", class: "link-action" %>
        <%= link_to "言葉一覧へ戻る", words_path, class: "link-action" %>
      </div>
    <% end %>
  </div>
</div>