<h1>パスワードの変更</h1>

<div class="login-container">
  <%= form_with(model: @user, url: password_path, method: :patch, local: true) do |f| %>
    <% if @user.errors.any? %>
      <div id="error_explanation">
        <h2><%= pluralize(@user.errors.count, "件のエラー") %> が発生しました：</h2>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :current_password, "現在のパスワード" %><br>
      <%= f.password_field :current_password, required: true, class: "login-input" %>
    </div>

    <div class="field">
      <%= f.label :password, "新しいパスワード" %><br>
      <%= f.password_field :password, required: true, class: "login-input" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "新しいパスワード（確認用）" %><br>
      <%= f.password_field :password_confirmation, required: true, class: "login-input" %>
    </div>

    <div class="actions">
      <%= f.submit "パスワードを変更する" %>
    </div>
  <% end %>

  <div style="margin-top: 15px;">
    <%= link_to "言葉一覧へ戻る", words_path %>
  </div>
</div>