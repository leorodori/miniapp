<h1 class="signup-title">新規登録</h1>

<div class="signup-container">
  <%= form_with model: @user, local: true do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.email_field :email, class: "signup-input" %>
    </div>

    <div class="field">
      <%= f.label :password, "パスワード" %><br>
      <%= f.password_field :password, class: "signup-input" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "パスワード（確認）" %><br>
      <%= f.password_field :password_confirmation, class: "signup-input" %>
    </div>

    <div class="actions">
      <%= f.submit "登録する" %>
    </div>
  <% end %>
</div>